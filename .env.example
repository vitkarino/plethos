# Shared local development defaults. Copy to .env and change all credentials.
POSTGRES_DB=plethos
POSTGRES_USER=plethos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://plethos:change-me@postgres:5432/plethos
TEST_DATABASE_URL=postgresql://plethos:change-me@postgres:5432/plethos_test

NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api
NUXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8080

# Device secrets are provisioned separately; never put Wi-Fi credentials here.
PLETHOS_DEVICE_TOKEN=replace-with-a-random-device-token
