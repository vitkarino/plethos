# Shared local development defaults. Copy to .env and change all credentials.
#
#   cp .env.example .env
#
# `.env` is git-ignored and never enters an image. Compose reads this file for
# variable substitution; the API container itself runs with APP_LOAD_DOTENV=0 and
# receives only the variables compose.yaml passes to it.

# --- Database -----------------------------------------------------------------
# POSTGRES_PASSWORD is required: the stack refuses to start without it rather
# than falling back to a default password.
POSTGRES_DB=plethos
POSTGRES_USER=plethos
POSTGRES_PASSWORD=change-me
# Host `postgres` is the Compose service name, not localhost.
DATABASE_URL=postgresql://plethos:change-me@postgres:5432/plethos
TEST_DATABASE_URL=postgresql://plethos:change-me@postgres:5432/plethos_test

# --- Public edge (Caddy) ------------------------------------------------------
# `localhost` uses Caddy's internal CA, so a browser warns once on first visit.
# Set a real DNS name to get an automatic public certificate via ACME.
PLETHOS_SITE_ADDRESS=localhost
PLETHOS_ACME_EMAIL=admin@localhost
# Change these if 443/80 are already in use, or if the host forbids binding
# privileged ports. If you do, add the port to PLETHOS_SITE_ADDRESS as well
# (e.g. `localhost:8443`) so Caddy's redirects and certificate names match the
# address a browser actually uses.
PLETHOS_HTTPS_PORT=443
PLETHOS_HTTP_PORT=80

# --- Development-only host ports (compose.override.yaml) ----------------------
# Bound to 127.0.0.1 only. Not used by `docker compose -f compose.yaml`.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8080

# --- API ----------------------------------------------------------------------
# Empty because the browser reaches the API same-origin through Caddy, so no
# cross-origin access is required. Set only if you bypass the proxy.
CORS_ORIGINS=
# Path to a trained recording-quality model artifact, if one is available.
QUALITY_MODEL_PATH=

# --- Assistant (LLM) ----------------------------------------------------------
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Client (Sprint 3) --------------------------------------------------------
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api
NUXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8080

# Device secrets are provisioned separately; never put Wi-Fi credentials here.
PLETHOS_DEVICE_TOKEN=replace-with-a-random-device-token
